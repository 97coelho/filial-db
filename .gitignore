# Ambientes virtuais e dependências Python
venv/
__pycache__/
*.py[cod]
*$py.class

# Bancos de dados locais (evita comitar dados reais/sensíveis)
*.db
*.sqlite
*.sqlite3

# Arquivos de dados originais (planilhas CSV contendo dados reais de clientes)
data_old/

# Planilhas preenchidas com dados sensíveis durante a migração
template_migracao_dados_preenchido.ods

# Arquivos de ambiente e chaves (se vier a usar no Flask)
.env
.flaskenv

# Configurações do Claude (memória local, cache)
.claude/

# Arquivos de sistema operacional
.DS_Store
Thumbs.db
